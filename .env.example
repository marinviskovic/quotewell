# Public values from Supabase > Project Settings > API. Never put the service_role key in a VITE_ variable:
# everything prefixed with VITE_ ends up in the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# The production address, used for canonical links, Open Graph, robots.txt and sitemap.xml.
VITE_SITE_URL=https://quotewell.app
# "true" runs the app on local sample data instead of Supabase.
VITE_DEMO_MODE=
